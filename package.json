    "resend": "6.37.0",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "stripe": "23.1.0",
    "tailwind-merge": "3.7.0",
    "tslog": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/vite": "4.3.5",
    "@types/negotiator": "0.6.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "knip": "6.44.1",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
