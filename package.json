{
  "name": "boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.32"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "knip": "knip",
    "dev": "vite dev",
    "prepare": "husky",
    "build": "vite build",
    "test:run": "vitest run",
    "lint": "eslint . --fix",
    "studio": "prisma studio",
    "format": "prettier --write .",
    "start": "node .output/server/index.mjs",
    "test:coverage": "vitest run --coverage",
    "services": "docker compose --file compose.dev.yaml up --detach --wait",
    "db": "prisma migrate dev && prisma format && prisma generate",
    "db:ia": "prisma migrate dev --name && prisma format && prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@better-auth/cimd": "1.7.15",
    "@better-auth/mcp": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@better-auth/passkey": "1.7.15",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@formatjs/intl-localematcher": "0.10.1",
    "@hookform/resolvers": "7.0.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@t3-oss/env-core": "0.13.11",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.15",
    "bullmq": "6.3.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "gray-matter": "4.0.3",
    "ioredis": "6.0.0",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "negotiator": "1.1.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-email": "6.11.6",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "react-qr-code": "2.2.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
