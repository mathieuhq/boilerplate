    "@tanstack/eslint-plugin-query": "5.105.1",
    "@types/negotiator": "0.6.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.44.1",
    "nitro": "3.0.261029-rc",
    "prettier": "3.9.10",
