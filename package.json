{
  "name": "boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13",
      "postcss": "8.5.14"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "knip": "knip",
    "dev": "vite dev",
    "prepare": "husky",
    "lint": "eslint . --fix",
    "build": "vite build",
    "test:run": "vitest run",
    "studio": "prisma studio",
    "format": "prettier --write .",
    "start": "node .output/server/index.mjs",
    "test:coverage": "vitest run --coverage",
    "db": "prisma migrate dev && prisma format && prisma generate",
    "db:ia": "prisma migrate dev --name && prisma format && prisma generate"
  },
