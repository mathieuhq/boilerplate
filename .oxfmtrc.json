{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "arrowParens": "always",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css"
  },
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react"]
      },
      {
        "groupName": "tanstack",
        "elementNamePattern": ["@tanstack/**"]
      },
      {
        "groupName": "scoped",
        "elementNamePattern": ["@*/**", "@/**"]
      }
    ],
    "groups": [
      "react",
      {
        "newlinesBetween": false
      },
      "tanstack",
      {
        "newlinesBetween": false
      },
      ["builtin", "external"],
      "scoped",
      "internal",
      "parent",
      ["sibling", "index"],
      ["style", "side_effect_style"],
      "side_effect",
      "unknown"
    ],
    "partitionByComment": true
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "drizzle/meta/**",
    "src/routeTree.gen.ts",
    ".agents/skills/security-audit/**"
  ]
}
