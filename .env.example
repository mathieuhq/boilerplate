# REQUIRED MINIMUM
NODE_ENV=development
DATABASE_URL="postgres://user:postgres@localhost:5432/boilerplate"

# DOCKER COMPOSE
APP_PORT=3000
REDIS_PORT=6379
POSTGRES_PORT=5432
POSTGRES_USER=user
REDIS_PASSWORD=redis
POSTGRES_DB=boilerplate
POSTGRES_PASSWORD=postgres
APP_BIND_ADDRESS=127.0.0.1

# OPTIONAL AUTH
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_ADMIN_EMAIL=admin@example.com,second-admin@example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-strong-secret-with-openssl-rand-base64-32

# OPTIONAL OAUTH
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL EMAIL (EMAIL_API_KEY + EMAIL_FROM are required together)
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_API_BASE_URL=
EMAIL_CONTACT_LIST_ID=

# REDIS: rate limiting and Better Auth sessions (optional with pnpm dev, required in production)
REDIS_URL="redis://:redis@localhost:6379"

# CLIENT IP: header set by your reverse proxy (cf-connecting-ip, x-real-ip, x-forwarded-for), empty without proxy
TRUSTED_IP_HEADER=

# OPTIONAL CLOUDFLARE R2 STORAGE
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
