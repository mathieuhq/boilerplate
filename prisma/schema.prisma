generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  EN
  FR
  DE
  ES
  PT
  RU
  JA
  KO
  ZH
}

enum NotificationType {
  ALL
  NONE
  MENTIONS
}

enum DataExportStatus {
  PENDING
  READY
  FAILED
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String
  emailVerified       Boolean             @default(false) @map("email_verified")
  image               String?
  language            Language            @default(EN)
  birthDate           DateTime?           @map("birth_date")
  emailContactId      String?             @map("email_contact_id")
  communicationEmails Boolean             @default(true) @map("communication_emails")
  marketingEmails     Boolean             @default(true) @map("marketing_emails")
  socialEmails        Boolean             @default(true) @map("social_emails")
  securityEmails      Boolean             @default(true) @map("security_emails")
  notificationType    NotificationType    @default(ALL) @map("notification_type")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  lastLoginAt         DateTime?           @map("last_login_at")
  deletedAt           DateTime?           @map("deleted_at")
  stripeCustomerId    String?             @map("stripe_customer_id")
  sessions            Session[]
  accounts            Account[]
  members             Member[]
  invitations         Invitation[]
  auditLogs           AuditLog[]          @relation("AuditLogActor")
  passkeys            Passkey[]
  apiKeys             Apikey[]
  oauthClients        OauthClient[]
  oauthRefreshTokens  OauthRefreshToken[]
  oauthAccessTokens   OauthAccessToken[]
  oauthConsents       OauthConsent[]
  notifications       Notification[]
  dataExports         DataExport[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  @@unique([email])
  @@index([emailContactId])
  @@index([deletedAt])
  @@index([role])
  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  token                String
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  expiresAt            DateTime @map("expires_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeOrganizationId String?  @map("active_organization_id")

  impersonatedBy String? @map("impersonated_by")

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@index([userId, expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, providerId, accountId])
  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  expiresAt  DateTime @map("expires_at")

  @@index([identifier])
  @@index([identifier, expiresAt])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String    @map("public_key") @db.Text
  userId       String    @map("user_id")
  credentialID String    @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Apikey {
  id                  String    @id @default(cuid())
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id")
  prefix              String?
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at")
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @map("rate_limit_time_window")
  rateLimitMax        Int?      @map("rate_limit_max")
  requestCount        Int?      @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  permissions         String?   @db.Text
  metadata            String?   @db.Text
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model Organization {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  logo             String?
  metadata         String?
  createdAt        DateTime     @default(now()) @map("created_at")
  stripeCustomerId String?      @map("stripe_customer_id")
  members          Member[]
  invitations      Invitation[]
  auditLogs        AuditLog[]

  @@map("organization")
}

model Subscription {
  id                   String    @id @default(cuid())
  plan                 String
  referenceId          String    @map("reference_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  status               String    @default("incomplete")
  periodStart          DateTime? @map("period_start")
  periodEnd            DateTime? @map("period_end")
  trialStart           DateTime? @map("trial_start")
  trialEnd             DateTime? @map("trial_end")
  cancelAtPeriodEnd    Boolean?  @default(false) @map("cancel_at_period_end")
  cancelAt             DateTime? @map("cancel_at")
  canceledAt           DateTime? @map("canceled_at")
  endedAt              DateTime? @map("ended_at")
  seats                Int?
  billingInterval      String?   @map("billing_interval")
  stripeScheduleId     String?   @map("stripe_schedule_id")

  @@index([referenceId])
  @@map("subscription")
}

model AuditLog {
  id             String        @id @default(cuid())
  actorUserId    String?       @map("actor_user_id")
  actorType      String        @map("actor_type")
  organizationId String?       @map("organization_id")
  action         String
  resourceType   String        @map("resource_type")
  resourceId     String?       @map("resource_id")
  metadata       Json?
  ipHash         String?       @map("ip_hash")
  userAgentHash  String?       @map("user_agent_hash")
  createdAt      DateTime      @default(now()) @map("created_at")
  actorUser      User?         @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("role")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  data      Json
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([readAt, createdAt])
  @@map("notification")
}

model DataExport {
  id          String           @id @default(cuid())
  userId      String?          @map("user_id")
  status      DataExportStatus @default(PENDING)
  fileKey     String?          @map("file_key")
  size        Int?
  createdAt   DateTime         @default(now()) @map("created_at")
  completedAt DateTime?        @map("completed_at")
  expiresAt   DateTime         @map("expires_at")
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("data_export")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  email          String
  role           String
  status         String
  expiresAt      DateTime     @map("expires_at")
  inviterId      String       @map("inviter_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @map("public_key") @db.Text
  privateKey String    @map("private_key") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(cuid())
  clientId                         String                @map("client_id")
  clientSecret                     String?               @map("client_secret")
  clientDiscoveryId                String?               @map("client_discovery_id")
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?              @map("skip_consent")
  enableEndSession                 Boolean?              @map("enable_end_session")
  subjectType                      String?               @map("subject_type")
  scopes                           Json?
  clientCredentialsScopes          Json?                 @default("[]") @map("client_credentials_scopes")
  userId                           String?               @map("user_id")
  createdAt                        DateTime?             @default(now()) @map("created_at")
  updatedAt                        DateTime?             @updatedAt @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?               @map("software_id")
  softwareVersion                  String?               @map("software_version")
  softwareStatement                String?               @map("software_statement") @db.Text
  redirectUris                     String[]              @map("redirect_uris")
  postLogoutRedirectUris           Json?                 @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?               @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?              @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?               @map("token_endpoint_auth_method")
  applicationType                  String?               @map("application_type")
  jwks                             String?               @db.Text
  jwksUri                          String?               @map("jwks_uri")
  grantTypes                       Json?                 @map("grant_types")
  responseTypes                    Json?                 @map("response_types")
  requirePKCE                      Boolean?              @map("require_pkce")
  dpopBoundAccessTokens            Boolean?              @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?               @map("reference_id")
  metadata                         Json?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauth_client")
}

model OauthResource {
  id                            String                @id @default(cuid())
  identifier                    String
  name                          String
  accessTokenTtl                Int?                  @map("access_token_ttl")
  refreshTokenTtl               Int?                  @map("refresh_token_ttl")
  signingAlgorithm              String?               @map("signing_algorithm")
  signingKeyId                  String?               @map("signing_key_id")
  allowedScopes                 Json?                 @map("allowed_scopes")
  customClaims                  Json?                 @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?              @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?             @default(now()) @map("created_at")
  updatedAt                     DateTime?             @updatedAt @map("updated_at")
  policyVersion                 Int?                  @default(1) @map("policy_version")
  metadata                      Json?
  clients                       OauthClientResource[]

  @@unique([identifier])
  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id @default(cuid())
  clientId   String        @map("client_id")
  resourceId String        @map("resource_id")
  metadata   Json?
  createdAt  DateTime?     @default(now()) @map("created_at")
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String             @id @default(cuid())
  token                   String
  clientId                String             @map("client_id")
  sessionId               String?            @map("session_id")
  userId                  String             @map("user_id")
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               Json?
  requestedUserInfoClaims Json?              @map("requested_user_info_claims")
  expiresAt               DateTime           @map("expires_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  revoked                 DateTime?
  rotatedAt               DateTime?          @map("rotated_at")
  rotationReplayResponse  String?            @map("rotation_replay_response") @db.Text
  rotationReplayExpiresAt DateTime?          @map("rotation_replay_expires_at")
  authTime                DateTime?          @map("auth_time")
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens            OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id @default(cuid())
  token                   String
  clientId                String             @map("client_id")
  sessionId               String?            @map("session_id")
  userId                  String?            @map("user_id")
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               Json?
  requestedUserInfoClaims Json?              @map("requested_user_info_claims")
  refreshId               String?            @map("refresh_id")
  expiresAt               DateTime           @map("expires_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id @default(cuid())
  clientId                String      @map("client_id")
  userId                  String?     @map("user_id")
  referenceId             String?     @map("reference_id")
  resources               Json?
  requestedUserInfoClaims Json?       @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("oauth_client_assertion")
}
