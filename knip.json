{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "paths": {
    "@/*": ["./*"],
    "@/features/*": ["./src/features/*"],
    "@/i18n": ["./src/i18n/index"],
    "@/i18n/*": ["./src/i18n/*"],
    "@/mcp/*": ["./src/mcp/*"],
    "@/server-functions/*": ["./src/server-functions/*"],
    "@/shared/*": ["./src/shared/*"],
    "@/test/*": ["./src/test/*"]
  },
  "ignore": ["components/ui/**"],
  "ignoreBinaries": ["docker-compose"],
  "ignoreDependencies": [
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser"
  ],
  "treatConfigHintsAsErrors": false,
  "entry": [
    "lib/shutdown.ts",
    "src/app/**/*.{ts,tsx}",
    "src/i18n/server.ts",
    "src/server-functions/**/*.{ts,tsx}"
  ],
  "project": [
    "components/**/*.{ts,tsx}",
    "views/**/*.{ts,tsx}",
    "hooks/**/*.ts",
    "contexts/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.css",
    "prisma/**/*.prisma",
    "!**/__tests__/**",
    "!**/*.test.ts"
  ]
}
