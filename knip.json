{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "paths": {
    "@/*": ["./*"],
    "@/features/*": ["./src/features/*"],
    "@/i18n": ["./src/i18n/index"],
    "@/i18n/*": ["./src/i18n/*"],
    "@/server-functions/*": ["./src/server-functions/*"],
    "@/shared/*": ["./src/shared/*"],
    "@/test/*": ["./src/test/*"]
  },
  "ignore": [
    ".claude/**",
    "components/ui/**",
    "prisma/**",
    "lib/generated/**",
    "coverage/**",
    ".output/**",
    "dist/**",
    "src/routeTree.gen.ts"
  ],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "tailwindcss",
    "tw-animate-css"
  ],
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/router.tsx",
    "vitest.config.ts",
    "eslint.config.mjs",
    "vite.config.ts"
  ],
  "project": [
    "components/**/*.{ts,tsx}",
    "views/**/*.{ts,tsx}",
    "hooks/**/*.ts",
    "contexts/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "schemas/**/*.ts",
    "types/**/*.ts",
    "src/**/*.ts",
    "!**/__tests__/**",
    "!**/*.test.ts"
  ]
}
